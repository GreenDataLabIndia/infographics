class ViewModel
  constructor: (json) ->
    @data = ko.mapping.fromJS json
    @selected = ko.observable(@data()[2])
    @modal = ko.observable(false)

    window.dta = @data

  selectYear: (yData, e) =>
    current = @selected()
    current.active(false)

    yData.active(true)
    @selected(yData)

  getThumb: =>
    if @modal()
      @selected().graph.thumb()
    else
      @selected().modal.thumb()

  toggleView: ->
    @modal(!@modal())

  yearsWithData: ->
    y_w_d = []
    for y in @data()
      y_w_d.push(y.year()) if not y.empty()

    return y_w_d

  next: =>
    year = @selected().year()
    ywd = @yearsWithData()
    i = ywd.indexOf(year)

    if i + 1 is ywd.length
      year = ywd[0]
    else
      year = ywd[i+1]

    for y in @data()
      @selectYear(y) if y.year() is year

  prev: =>
    year = @selected().year()
    ywd = @yearsWithData()
    i = ywd.indexOf(year)

    if i
      year = ywd[i-1]
    else
      year = ywd[ywd.length - 1]

    for y in @data()
      @selectYear(y) if y.year() is year


$ ->
  vm = new ViewModel(SlideshowJSON)
  ko.applyBindings(vm)